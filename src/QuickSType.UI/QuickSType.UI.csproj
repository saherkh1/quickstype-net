<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>QuickSType.UI</RootNamespace>
    <AssemblyName>QuickSType</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime.CoreML" Version="1.9.0" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="1.9.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.osx-arm64" Version="1.0.6" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.osx-x64" Version="1.0.6" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.win-x64" Version="1.0.6" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickSType.Core\QuickSType.Core.csproj" />
    <ProjectReference Include="..\QuickSType.Platform.Mac\QuickSType.Platform.Mac.csproj" />
    <ProjectReference Include="..\QuickSType.Platform.Windows\QuickSType.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- HARDEN-01: model SHA-256 manifest must travel with the binary. -->
    <Content Include="..\..\models\manifest.json" Link="models\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- HARDEN-05: smoke fixture + expected contract for CI smoke-test invocation. -->
    <Content Include="..\..\tests\fixtures\smoke.wav" Link="tests\fixtures\smoke.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tests\fixtures\smoke.expected.json" Link="tests\fixtures\smoke.expected.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
