<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuickSType.UI.ViewModels"
        xmlns:transcribe="using:QuickSType.Core.Transcribe"
        x:Class="QuickSType.UI.Views.LanguageModelFlyoutWindow"
        x:DataType="vm:LanguageModelFlyoutViewModel"
        Title="Model for this language"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="Full"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <Grid Margin="32,24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

    <TextBlock Grid.Row="0" Classes="h1"
               Text="{Binding LangCode, StringFormat='Model for {0}'}" />

    <TextBlock Grid.Row="1" Classes="muted" Margin="0,4,0,12"
               Text="Language-specific models for this language. Select a model or use the global model." />

    <Border Grid.Row="2"
            Background="{DynamicResource SystemAltLowColor}"
            BorderBrush="{DynamicResource SystemBaseLowColor}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8"
            Margin="0,0,0,8">
      <StackPanel Spacing="4">
        <TextBlock FontWeight="SemiBold" FontSize="13" Text="Language-specific models" />
        <ListBox ItemsSource="{Binding AvailableLanguageModels}"
                 SelectedValue="{Binding SelectedModelId}"
                 SelectedValueBinding="{Binding Id}"
                 MaxHeight="180">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="transcribe:ModelInfo">
              <StackPanel Margin="4,2">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Opacity="0.7" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <Border Grid.Row="3"
            Background="{DynamicResource SystemAltLowColor}"
            BorderBrush="{DynamicResource SystemBaseLowColor}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,8"
            Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <RadioButton Content="Use global model"
                     GroupName="ModelChoice"
                     Command="{Binding SelectGlobalModelCommand}"
                     IsChecked="{Binding SelectedModelId,
                                 Converter={x:Static StringConverters.IsNullOrEmpty}}" />
        <TextBlock Text="{Binding GlobalModelId, StringFormat='({0})'}"
                   Opacity="0.7"
                   VerticalAlignment="Center"
                   FontSize="12" />
      </StackPanel>
    </Border>

    <ProgressBar Grid.Row="4"
                 Value="{Binding DownloadPercent}"
                 Maximum="100"
                 Height="6"
                 Margin="0,0,0,4"
                 IsVisible="{Binding IsDownloading}" />

    <TextBlock Grid.Row="5"
               Text="{Binding DownloadStatus}"
               FontSize="11"
               Opacity="0.7"
               Margin="0,0,0,4"
               IsVisible="{Binding IsDownloading}" />

    <StackPanel Grid.Row="6"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="12"
                Margin="0,16,0,0">
      <Button Content="Cancel"
              IsCancel="True"
              MinWidth="100" />
      <Button Content="Download"
              Command="{Binding DownloadCommand}"
              MinWidth="100"
              IsVisible="{Binding CanDownload}" />
      <Button Content="Save"
              Classes="accent"
              IsDefault="True"
              Command="{Binding SaveAssignmentCommand}"
              MinWidth="100" />
    </StackPanel>

  </Grid>
</Window>
