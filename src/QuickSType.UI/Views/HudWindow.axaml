<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuickSType.UI.ViewModels"
        xmlns:controls="using:QuickSType.UI.Controls"
        x:Class="QuickSType.UI.Views.HudWindow"
        x:DataType="vm:HudViewModel"
        Title=""
        Width="240" Height="80"
        SystemDecorations="None"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        CanResize="False"
        Background="{x:Null}"
        TransparencyLevelHint="Blur, Transparent"
        WindowStartupLocation="Manual">

  <Border CornerRadius="12"
          BorderThickness="1"
          Padding="12">
    <Border.Background>
      <SolidColorBrush Color="#CC1C1C1E" />
    </Border.Background>
    <Border.BorderBrush>
      <SolidColorBrush Color="#14FFFFFF" />
    </Border.BorderBrush>

    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">

      <!-- Waveform control - fills row 0, col 0 -->
      <controls:WaveformControl x:Name="Waveform"
                                 Grid.Row="0" Grid.Column="0"
                                 BarColor="#FF3B30"
                                 IsVisible="{Binding IsActive}" />

      <!-- REC dot - row 0, col 1 -->
      <Ellipse x:Name="RecDot"
               Grid.Row="0" Grid.Column="1"
               Width="12" Height="12"
               Fill="#FF3B30"
               VerticalAlignment="Bottom"
               Margin="8,0,0,4"
               IsVisible="{Binding IsActive}" />

      <!-- Elapsed counter - row 1, spans both columns -->
      <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                 Text="{Binding ElapsedText}"
                 FontSize="12"
                 FontWeight="SemiBold"
                 Foreground="#99FFFFFF"
                 HorizontalAlignment="Right"
                 Margin="0,4,4,0"
                 IsVisible="{Binding IsActive}" />
    </Grid>
  </Border>

</Window>
