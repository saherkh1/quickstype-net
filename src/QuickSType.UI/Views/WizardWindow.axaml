<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QuickSType.UI.Views.WizardWindow"
        Title="Welcome to QuickSType"
        Width="600" Height="540"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
  <Grid RowDefinitions="*,Auto" Margin="32">
    <ScrollViewer Grid.Row="0">
      <StackPanel Name="StepHost" Spacing="16" />
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
      <Button Content="Back" Name="BackButton" />
      <Button Content="Next" Name="NextButton" Classes="accent" />
    </StackPanel>
  </Grid>
</Window>
